{
    "tasks": [
        {
            "type": "process",
            "label": "Pintos: build threads",
            "command": "make",
            "args": [
                "-C",
                "${workspaceFolder}/pintos/threads"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                {
                    "base": "$gcc",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}/pintos/threads/build"
                    ]
                }
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the Pintos threads kernel using the project Makefiles."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
